<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:fillViewport="true"
    android:fitsSystemWindows="true"

    tools:context=".HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/greeting_bg"
                android:padding="12dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_leaf"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi,"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#000" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/menu_bg"
                android:src="@drawable/ic_menu"
                android:scaleType="centerInside"
                android:padding="12dp" />
        </LinearLayout>

        <!-- =============== MODULES CARD =============== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            android:backgroundTint="#E6E6E6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    android:backgroundTint="#FFE2CC">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mindfulness Modules"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#000"
                            android:layout_marginBottom="12dp"/>

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:src="@drawable/ic_mindfulness"
                            android:scaleType="fitCenter"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <!-- Focused Attention -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvFocusedAttention"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#D1E3F6">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Focused Attention"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#000"/>

                            <TextView
                                android:id="@+id/tvMinutesFocused"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="#555"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/bg_minutes"/>

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_bukky"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Working Memory -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvWorkingMemory"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#FFE3EC">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Working Memory"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#000"/>

                            <TextView
                                android:id="@+id/tvMinutesWorking"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/bg_minutes"
                                android:text="--"
                                android:textColor="#555"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_working_memory"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <!-- Present Moment -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvPresentMoment"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#CDEBFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Present-Moment Awareness"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#000"/>

                            <TextView
                                android:id="@+id/tvMinutesPresent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="#555"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/bg_minutes"/>

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_present_moment"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Cognitive Integration -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvCognitiveIntegration"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#E9D1F6">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cognitive Integration"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#000"/>

                            <TextView
                                android:id="@+id/tvMinutesCognitive"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="#555"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/bg_minutes"/>

                            <ImageView
                                android:layout_width="98dp"
                                android:layout_height="44dp"
                                android:src="@drawable/extracted_image"
                                android:adjustViewBounds="true"
                                android:scaleType="fitEnd"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Emotional -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvEmotionalRegulation"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:backgroundTint="#FFF9C4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Emotional Regulation"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#000"/>

                        <TextView
                            android:id="@+id/tvMinutesEmotional"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#555"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/bg_minutes"/>

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/ic_er"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Progress Dashboard -->

        <!-- Progress Dashboard -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvProgressDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            android:backgroundTint="#C2BBFF"
            android:clickable="false"
            android:focusable="false">


        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:text="Progress Dashboard"
                    android:textSize="22sp"
                    android:textColor="#222"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:text="Track your mindfulness journey"
                    android:textSize="15sp"
                    android:textColor="#444"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_dashboard_graph"
                    android:contentDescription="Dashboard graph"
                    android:layout_gravity="end" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Scores Section -->
        <!-- Memory Score -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvMemoryScore"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            android:backgroundTint="#D7F3E7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Memory Score"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#292929"/>

                <TextView
                    android:id="@+id/tvScoreMemory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#222"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_memory"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Row 1 Scores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Attention -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvAttentionScore"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                android:backgroundTint="#D1E3F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attention Score"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#292929"/>

                    <TextView
                        android:id="@+id/tvScoreAttention"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="15sp"
                        android:textColor="#222"/>

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/target_icon"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Emotional -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvEmotionScore"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                android:backgroundTint="#FFE3EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emotional Regulation"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#292929"/>

                    <TextView
                        android:id="@+id/tvScoreEmotional"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="15sp"
                        android:textColor="#222"/>

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_emotion"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 2 Scores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Cognitive -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvCognitiveScore"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                android:backgroundTint="#E9D1F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cognitive Score"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#292929"/>

                    <TextView
                        android:id="@+id/tvScoreCognitive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="15sp"
                        android:textColor="#222"/>

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/target_icon"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Present -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvPresentMomentScore"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                android:backgroundTint="#CDEBFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Present Awareness"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#292929"/>

                    <TextView
                        android:id="@+id/tvScorePresent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="15sp"
                        android:textColor="#222"/>

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_emotion"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ✅ ADDED CHART SECTION HERE -->

        <!-- ✅ GRAPH SECTION BELOW DASHBOARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvGraphSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mindfulness Progress Graph"
                    android:textColor="#000"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#FAFAFA"
                    android:padding="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


    </LinearLayout>

</ScrollView>
