<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    tools:context=".HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header with Leaf Icon, Greeting, and Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Leaf Icon and Greeting Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/greeting_bg"
                android:padding="12dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_leaf"
                    android:contentDescription="@string/leaf"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi, Martha"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/menu_bg"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu"
                android:scaleType="centerInside"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Modules Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            android:backgroundTint="#E6E6E6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvMindfulnessHeader"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    android:backgroundTint="#FFE2CC">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mindfulness Modules"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:layout_marginBottom="12dp"/>

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:adjustViewBounds="true"
                            android:contentDescription="Mindfulness Illustration"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_mindfulness" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:weightSum="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvFocusedAttention"
                        android:layout_width="0dp"
                        android:layout_height="143dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#D1E3F6">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Focused Attention"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6 min"
                                android:textSize="14sp"
                                android:textColor="#555"
                                android:background="@drawable/bg_minutes"
                                android:translationX="-40dp"
                                android:translationY="4dp"/>

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_bukky"
                                android:contentDescription="Mindfulness Icon"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvWorkingMemory"
                        android:layout_width="0dp"
                        android:layout_height="143dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#FFE3EC">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Working Memory"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="13 min"
                                android:textSize="14sp"
                                android:textColor="#555"
                                android:background="@drawable/bg_minutes"
                                android:translationX="-34dp"
                                android:translationY="4dp"/>

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_working_memory"
                                android:contentDescription="@string/working_memory_icon"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:weightSum="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvPresentMoment"
                        android:layout_width="0dp"
                        android:layout_height="143dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#CDEBFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Present-Moment Awareness"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:gravity="center"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20 min"
                                android:textSize="14sp"
                                android:textColor="#555"
                                android:background="@drawable/bg_minutes"
                                android:translationX="-38dp"
                                android:translationY="4dp"/>

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_present_moment"
                                android:contentDescription="Present-Moment Awareness Icon"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvCognitiveIntegration"
                        android:layout_width="0dp"
                        android:layout_height="143dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#E9D1F6">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="95dp"
                                android:layout_height="46dp"
                                android:text="Cognitive Integration"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#000"
                                android:gravity="center"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18 min"
                                android:textSize="14sp"
                                android:textColor="#555"
                                android:background="@drawable/bg_minutes"
                                android:translationX="-32dp"
                                android:translationY="4dp"/>

                            <ImageView
                                android:layout_width="98dp"
                                android:layout_height="44dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/extracted_image"
                                android:contentDescription="Cognitive Integration Icon"
                                android:scaleType="fitEnd"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Full-Width Emotional Regulation -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvEmotionalRegulation"
                    android:layout_width="match_parent"
                    android:layout_height="143dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:backgroundTint="#FFF9C4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Emotional Regulation"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#000"
                            android:gravity="center"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 min"
                            android:textSize="14sp"
                            android:textColor="#555"
                            android:background="@drawable/bg_minutes"
                            android:translationX="-48dp"
                            android:translationY="4dp"/>

                        <ImageView
                            android:id="@+id/imgEmotionalRegulation"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/ic_er"
                            android:contentDescription="Emotional Regulation Icon"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Progress Dashboard Header -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvProgressDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            android:backgroundTint="#C2BBFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:text="Progress Dashboard"
                    android:textSize="22sp"
                    android:textColor="#222"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:text="Track your mindfulness journey"
                    android:textSize="15sp"
                    android:textColor="#444"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_dashboard_graph"
                    android:contentDescription="Dashboard graph"
                    android:layout_gravity="end" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Vertical Memory Score Full Width -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvMemoryScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            android:backgroundTint="#D7F3E7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="143dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Memory Score"
                    android:textColor="#292929"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.8/7"
                    android:textColor="#222"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="5dp"
                    android:contentDescription="@string/memory_icon"
                    android:src="@drawable/ic_memory" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Horizontal Row: Attention + Emotion Score Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="12dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvAttentionScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                android:backgroundTint="#D7E6F3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="143dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center">

                    <TextView
                        android:text="Attention Score"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#292929"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="5.2/7"
                        android:textSize="15sp"
                        android:textColor="#222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/target_icon"
                        android:contentDescription="Attention Icon"
                        android:layout_marginTop="5dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cvEmotionScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                android:backgroundTint="#E6CFFA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="143dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">

                    <TextView
                        android:text="Emotional Regulation"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#292929"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="5.1/7"
                        android:textSize="15sp"
                        android:textColor="#222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_emotion"
                        android:contentDescription="@string/emotion_icon"
                        android:layout_marginTop="5dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Chart Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvGraphSection"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            android:backgroundTint="#F7F6FA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="22dp">

                <ImageView
                    android:id="@+id/imgChart"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:contentDescription="Trend chart"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attention"
                        android:textColor="#AE8DF6"
                        android:textSize="13sp"
                        android:layout_marginEnd="15dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memory"
                        android:textColor="#72D277"
                        android:textSize="13sp"
                        android:layout_marginEnd="15dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emotion"
                        android:textColor="#F6AEDC"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
