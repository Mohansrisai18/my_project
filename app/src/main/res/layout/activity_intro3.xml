<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5E6E6"
   >

    <!-- Status Bar Area -->

    <!-- Intro 3 Label -->
    <View
        android:id="@+id/topRightCircle"
        android:layout_width="124dp"
        android:layout_height="110dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/top_right_circle" />


    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_centerInParent="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="80dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Progress Chart Icon -->
        <ImageView
            android:id="@+id/progressIcon"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginBottom="40dp"
            android:src="@drawable/ic_progress_chart"
            android:contentDescription="Progress Chart"
            android:scaleType="fitCenter" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/how_your_progress_is_tracked"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Description -->
        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/we_use_validated_psychological_scales_and_cognitive_tasks_to_measure_your_progress_over_time_giving_you_clear_insights_into_your_mental_wellness_journey"
            android:textSize="20sp"
            android:textColor="#666666"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="80dp"
            android:fontFamily="sans-serif-light" />

    </LinearLayout>

    <!-- Bottom Navigation Buttons -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Back Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/btn_bg"
            android:text="@string/back"
            android:textStyle="bold"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:textColor="#000000"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Next Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNext"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_bg"
            android:text="Next"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</RelativeLayout>
