<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8E8E6"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/backButtonIntro"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="Back"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvIntroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Module Title"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="12dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvIntroSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Why Pre-Assessment?"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginTop="4dp" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvIntroDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description here..."
            android:textColor="#000000"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="16dp" />

        <!-- Pre Assessment Button -->
        <Button
            android:id="@+id/btnStartPreAssessment"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Start Pre-Assessment"
            android:layout_marginTop="24dp"
            android:textStyle="bold"
            android:background="@drawable/btn_bg" />

        <!-- Continue Button -->
        <Button
            android:id="@+id/btnContinueToModule"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Continue to Module"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:background="@drawable/btn_bg"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
