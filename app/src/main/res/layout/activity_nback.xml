<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F8E8E6"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="24dp">

    <!-- Instruction -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap when the current letter matches the letter shown two steps earlier (one in between)."
        android:textColor="#000"
        android:textSize="18sp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:layout_marginBottom="30dp" />

    <!-- Letter Display -->
    <TextView
        android:id="@+id/tvLetter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A"
        android:textColor="#000"
        android:textSize="120sp"
        android:textStyle="bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:layout_marginBottom="40dp"
        android:contentDescription="Current letter"
        android:clickable="true"
        android:focusable="true" />

    <!-- Match Button -->
    <Button
        android:id="@+id/btnMatch"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:text="MATCH"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_bg" />

    <!-- Score (hidden until shown by activity) -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score: --%"
        android:textColor="#444"
        android:textSize="16sp"
        android:layout_marginTop="30dp"
        android:visibility="gone" />

    <!-- Info -->
    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#777"
        android:textSize="16sp"
        android:layout_marginTop="5dp"
        android:gravity="center" />

</LinearLayout>
