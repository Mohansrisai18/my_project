<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F7F7F7">

    <!-- Header Section -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@android:color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="66dp"
            android:layout_height="61dp"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/chevron_right" />

        <TextView
            android:id="@+id/tvScoreTypeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attention Score"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/backButton"
            android:layout_marginStart="20dp"/>
    </RelativeLayout>

    <!-- Main Score Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLatestScore"
        android:layout_below="@id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="18dp"
        android:elevation="8dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        android:backgroundTint="@android:color/white"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLatestScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.2"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latest Score"
                android:textSize="16sp"
                android:textColor="#555"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Score History Label -->
    <TextView
        android:id="@+id/tvHistoryLabel"
        android:layout_below="@id/cardLatestScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        android:text="Score History"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000"/>

    <!-- Score History List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerScoreHistory"
        android:layout_below="@id/tvHistoryLabel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="18dp"/>
</RelativeLayout>
