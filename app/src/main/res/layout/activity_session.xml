<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8E8E6"
    android:padding="18dp">

    <!-- Back button -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/chevron_right"
        android:background="@null"
        app:tint="#333333" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvAudioTitle"
        android:layout_marginTop="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Session 01"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvAudioDesc"
        android:layout_marginTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Breathing and awareness"
        android:textSize="15sp"
        android:textColor="#666666"/>

    <!-- ========= AUDIO PLAYER BOX ========= -->
    <RelativeLayout
        android:id="@+id/audioCard"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/audio_box_bg"
        android:padding="20dp">

        <!-- BIGGER CENTER LOGO -->
        <ImageView
            android:id="@+id/bgLogo"
            android:layout_centerInParent="true"
            android:layout_width="290dp"
            android:layout_height="290dp"
            android:src="@drawable/logo_1"
            android:scaleType="centerInside"
            android:alpha="0.18"/>

        <!-- PREVIOUS -->
        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@null"
            android:src="@drawable/ic_prev"
            app:tint="#444444" />

        <!-- PLAY / PAUSE -->
        <ImageButton
            android:id="@+id/playPauseButton"
            android:layout_centerInParent="true"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/circle_soft_bg"
            android:src="@drawable/ic_play"
            app:tint="#000000" />

        <!-- NEXT -->
        <ImageButton
            android:id="@+id/btnNext"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@null"
            android:src="@drawable/ic_next"
            app:tint="#444444" />

        <!-- SEEK BAR -->
        <SeekBar
            android:id="@+id/progressBar"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb" />

    </RelativeLayout>

    <!-- Finish button -->
    <Button
        android:id="@+id/btnFinishSave"
        android:layout_marginTop="36dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Finish &amp; Save"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D32"
        android:textSize="16sp"
        android:textAllCaps="false"/>
</LinearLayout>
