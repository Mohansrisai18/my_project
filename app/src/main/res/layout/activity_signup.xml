<?xml version="1.0" encoding="utf-8"?>
<!-- Updated: handles status bar + nav bar + keyboard insets -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/signupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg"
    android:overScrollMode="never"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    tools:context=".SignupActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_white_bg"
            android:padding="16dp"
            android:layout_margin="20dp"
            android:focusableInTouchMode="true">

            <!-- Logo -->
            <ImageView
                android:layout_width="300dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:src="@drawable/logo_1"
                android:contentDescription="logo" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:text="Create Account"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <!-- User ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="User id"
                android:textSize="20sp"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/fullNameInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/edittext_bg"
                android:hint="enter user id"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:textSize="13sp" />

            <!-- Age -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Age"
                android:textSize="20sp"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/ageInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/edittext_bg"
                android:hint="Enter age"
                android:inputType="number"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:textSize="13sp" />

            <!-- Gender -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Gender"
                android:textSize="20sp"
                android:textColor="#000000" />

            <Spinner
                android:id="@+id/genderSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/edittext_bg"
                android:spinnerMode="dropdown"
                android:gravity="center_vertical" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="E-mail"
                android:textSize="20sp"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/mailInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/edittext_bg"
                android:hint="Enter mail id"
                android:inputType="textEmailAddress"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:textSize="12sp" />

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Password"
                android:textSize="20sp"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/edittext_bg"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:textSize="13sp"
                android:drawableEnd="@drawable/ic_eye_closed"
                android:paddingEnd="48dp" />

            <!-- Sign Up -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSignup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/btn_bg"
                android:text="Sign up"
                android:textStyle="bold" />

            <!-- Login -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account?"
                    android:textColor="#000000"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/loginText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log in"
                    android:textColor="#D84315"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- extra bottom padding ensures last control is scrollable above nav/IME -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
