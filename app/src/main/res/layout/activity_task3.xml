<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    tools:context=".Task3Activity">

    <!-- Decorative quarter circle in top-right -->
    <View
        android:id="@+id/topRightCircle"
        android:layout_width="94dp"
        android:layout_height="91dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/top_right_circle" />

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/circle_bg"
        android:src="@drawable/ic_arrow_back"
        android:scaleType="centerInside"
        android:contentDescription="@string/back_button" />

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:text="@string/lets_start_with_quiz"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:fontFamily="sans-serif" />

    <!-- Task Label -->
    <TextView
        android:id="@+id/taskLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="@string/task_3"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:fontFamily="sans-serif" />

    <!-- Instruction Text -->
    <TextView
        android:id="@+id/instructionText"
        android:layout_width="332dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/taskLabel"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/rate_instruction"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:textColor="#000000"
        android:textSize="18sp" />

    <!-- First Question Box -->
    <LinearLayout
        android:id="@+id/firstQuestionBox"
        android:layout_width="300dp"
        android:layout_height="180dp"
        android:layout_below="@id/instructionText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:background="@drawable/rounded_grey_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/question_task3_1"
            android:textColor="#000000"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <EditText
            android:id="@+id/firstInput"
            android:layout_width="match_parent"
            android:layout_height="63dp"
            android:layout_marginTop="20dp"
            android:autofillHints="none"
            android:background="@drawable/edittext_bg"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:hint="@string/enter_rating_hint"
            android:inputType="number"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Second Question Box -->
    <LinearLayout
        android:id="@+id/secondQuestionBox"
        android:layout_width="300dp"
        android:layout_height="180dp"
        android:layout_below="@id/firstQuestionBox"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_grey_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/question_task3_2"
            android:textColor="#000000"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/secondInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edittext_bg"
            android:gravity="center"
            android:hint="@string/enter_rating_hint"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:inputType="number"
            android:autofillHints="none"
            android:textColor="#000000"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Third Question Box -->
    <LinearLayout
        android:id="@+id/thirdQuestionBox"
        android:layout_width="300dp"
        android:layout_height="180dp"
        android:layout_below="@id/secondQuestionBox"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_grey_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/question_task3_3"
            android:textColor="#000000"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <EditText
            android:id="@+id/thirdInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edittext_bg"
            android:hint="@string/enter_rating_hint"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:inputType="number"
            android:autofillHints="none"
            android:textColor="#000000"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Next Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNext"
        android:layout_width="296dp"
        android:layout_height="67dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/thirdQuestionBox"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/btn_bg"
        android:fontFamily="sans-serif-medium"
        android:text="@string/next"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:textStyle="bold" />

</RelativeLayout>
