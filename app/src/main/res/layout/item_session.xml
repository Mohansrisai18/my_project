<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSession"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="14dp"
    android:minHeight="130dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="#1E1E1E">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session Title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/tvSessionDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session description text appears here…"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textColor="#CCCCCC"/>

        <TextView
            android:id="@+id/tvModuleTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Linked Task: focused_attention"
            android:layout_marginTop="10dp"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="#9F7BFF"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
